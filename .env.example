# Server Configuration
PORT=5000

# MongoDB Connection String (MongoDB Atlas or local mongodb://localhost:27017/ai_study_assistant)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/study_assistant?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/study_assistant?retryWrites=true&w=majority

# JWT Secret for authentication tokens
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Google Gemini API Key (Backend only - never expose to frontend)
# Get your free key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Preferred Gemini model
GEMINI_MODEL=gemini-2.0-flash
